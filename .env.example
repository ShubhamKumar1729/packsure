# Required for authenticated API routes and session verification.
AUTH_SECRET=replace-with-a-long-random-secret

# Required when login and inspection persistence are enabled.
MONGODB_URI=mongodb://127.0.0.1:27017/packsure

# Inspection analysis provider:
#   nlp  = REAL pipeline (OCR + legal-metrology NER) served by the Python service.
#          Requires NLP_SERVICE_URL below and the NLP service running.
#   mock = local test seam only: processes real image bytes, invents no values.
AI_PROVIDER=nlp

# PackSure NLP service (Python FastAPI, see nlp-service/ and docs/NLP_SERVICE_API.md).
# Local: http://localhost:8000   Docker compose: http://nlp:8000
NLP_SERVICE_URL=http://localhost:8000
# Optional shared secret; must match NLP_API_KEY configured on the service.
NLP_API_KEY=
# Optional request timeout (ms) for image analysis calls.
NLP_SERVICE_TIMEOUT_MS=90000

# Optional: set to production for secure cookies over HTTPS.
NODE_ENV=development

# ---------------------------------------------------------------------------------------
# NLP service-side variables (set in the SERVICE environment, not the web app):
#   MODEL_PATH=/path/to/nlp-service/model/legal_metrology_ner
#   MODEL_VERSION=1.0.0            # bump after each trained export
#   MODEL_BASE_MODEL=ModernBERT
#   NLP_OCR_LANG=eng               # tesseract language pack(s), e.g. eng+hin
#   NLP_CONFIDENCE_HIGH=0.85       # confidence bands (raw scores, not calibrated)
#   NLP_CONFIDENCE_MEDIUM=0.60
# ---------------------------------------------------------------------------------------

# ----------------------------------------------------------------------------------------
# Pia, the PackSure assistant. Server-side only: the key below is read by the API route in
# src/app/api/assistant/route.ts and is NEVER sent to browsers, bundled into client JavaScript,
# placed in NEXT_PUBLIC_* variables, returned in API responses, or written to logs.
# ----------------------------------------------------------------------------------------

# Required for Pia to answer. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: Groq model override. Default is openai/gpt-oss-120b (Groq's recommended successor to
# the retired llama-3.3-70b-versatile; strong at conversation, RAG grounding, and tool calling).
GROQ_MODEL=

# Optional overrides, mainly for self-hosted Groq-compatible gateways or integration tests:
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_RETRIEVAL_MODEL=openai/gpt-oss-20b
