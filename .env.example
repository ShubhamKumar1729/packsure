# Required for authenticated API routes and session verification.
AUTH_SECRET=replace-with-a-long-random-secret

# Required when login and inspection persistence are enabled.
MONGODB_URI=mongodb://127.0.0.1:27017/packsure

# Local testing only: processes real stored image bytes but returns no inferred values.
# Production must be set to a supported real provider implementation.
AI_PROVIDER=mock

# Optional: set to production for secure cookies over HTTPS.
NODE_ENV=development
