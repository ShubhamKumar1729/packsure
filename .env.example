# Required for authenticated API routes and session verification.
AUTH_SECRET=replace-with-a-long-random-secret

# Required when login and inspection persistence are enabled.
MONGODB_URI=mongodb://127.0.0.1:27017/packsure

# Local testing only: processes real stored image bytes but returns no inferred values.
# Production must be set to a supported real provider implementation.
AI_PROVIDER=mock

# Optional: set to production for secure cookies over HTTPS.
NODE_ENV=development

# ---------------------------------------------------------------------------------------------
# Compliance AI assistant (the conversational robot). Everything below is optional.
#
# With no assistant configuration the app still works: PackSure answers from its built-in offline
# responder, which uses the platform knowledge base plus your authorized records. The reply is then
# labelled "offline responder" in the chat so it is never mistaken for a live language model.
# Add one provider key below to switch the same assistant to real conversational answers.
# ---------------------------------------------------------------------------------------------

# auto | openai | anthropic | gemini | groq | openrouter | ollama | mock
# "auto" (default) picks the first provider that actually has a key configured.
# "ollama" is never auto-selected because a local model server needs no key.
# "mock" forces the offline responder.
ASSISTANT_PROVIDER=auto

# Overrides the default model for whichever provider is selected.
# Defaults: openai gpt-4o-mini · anthropic claude-sonnet-4-5 · gemini gemini-2.5-flash
#           groq llama-3.3-70b-versatile · openrouter openai/gpt-4o-mini · ollama llama3.2
# ASSISTANT_MODEL=

# Pick one named provider ---------------------------------------------------------------------

# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# GROQ_API_KEY=
# GROQ_MODEL=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local model server. Requires no key, so it must be requested explicitly:
#   ASSISTANT_PROVIDER=ollama
# OLLAMA_MODEL=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_API_KEY=ollama

# Or point at any other OpenAI-compatible gateway ------------------------------------------------
# Setting both of these wins over the named presets above, so any self-hosted or proxy inference
# server that speaks POST {base}/chat/completions can be used without code changes.
# ASSISTANT_API_KEY=
# ASSISTANT_BASE_URL=
# ASSISTANT_MODEL=gpt-4o-mini
