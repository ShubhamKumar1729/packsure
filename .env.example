# Required for authenticated API routes and session verification.
AUTH_SECRET=replace-with-a-long-random-secret

# Required when login and inspection persistence are enabled.
MONGODB_URI=mongodb://127.0.0.1:27017/packsure

# Inspection-image analysis ONLY (unrelated to Pia, whose provider is always Groq).
# Local testing only: processes real stored image bytes but returns no inferred values.
# Production must be set to a supported real provider implementation.
AI_PROVIDER=mock

# Optional: set to production for secure cookies over HTTPS.
NODE_ENV=development

# ---------------------------------------------------------------------------------------------
# Pia, the PackSure assistant. Server-side only: the key below is read by the API route in
# src/app/api/assistant/route.ts and is NEVER sent to browsers, bundled into client JavaScript,
# placed in NEXT_PUBLIC_* variables, returned in API responses, or written to logs.
# ---------------------------------------------------------------------------------------------

# Required for Pia to answer. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: Groq model override. Default is openai/gpt-oss-120b (Groq's recommended successor to
# the retired llama-3.3-70b-versatile; strong at conversation, RAG grounding, and tool calling).
GROQ_MODEL=

# Optional overrides, mainly for self-hosted Groq-compatible gateways or integration tests:
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_RETRIEVAL_MODEL=openai/gpt-oss-20b
