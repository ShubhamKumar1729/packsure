# Required for authenticated API routes and session verification.
AUTH_SECRET=replace-with-a-long-random-secret

# Required when login and inspection persistence are enabled.
MONGODB_URI=mongodb://127.0.0.1:27017/packsure

# Local testing only: processes real stored image bytes but returns no inferred values.
# Production must be set to a supported real provider implementation.
AI_PROVIDER=mock

# Optional: set to production for secure cookies over HTTPS.
NODE_ENV=development

# ---------------------------------------------------------------------------------------------
# Compliance AI assistant: needs NO configuration and NO environment variables.
# It runs a small open-source language model (SmolLM2-135M-Instruct, q4 ONNX) and a small
# embedding model (all-MiniLM-L6-v2, q8) entirely inside the browser via WebGPU/WebAssembly.
# Both are downloaded once from the open Hugging Face repository on first use and cached in the
# browser. No API key, no external AI service, no Ollama, nothing to install.
# ---------------------------------------------------------------------------------------------
